# Copie para .env e troque os valores: cp .env.example .env
AUTH_DB_PASSWORD=troque-esta-senha
JWT_SECRET=troque-este-segredo-por-um-texto-longo
PHOTO_DB_PASSWORD=troque-esta-senha-das-fotos

# Use os valores da identidade envio em secrets/seaweedfs-s3.json.
PHOTO_S3_ACCESS_KEY=fotos-envio
PHOTO_S3_SECRET_KEY=

# Inicialização do InfluxDB local. Use valores próprios no .env.
INFLUX_LOCAL_ADMIN_PASSWORD=
INFLUX_LOCAL_ADMIN_TOKEN=

# Consulta. Troque apenas estas três variáveis para acessar a VPS.
INFLUX_HOST=http://influxdb:8086
INFLUX_ORG=horticultura-local
INFLUX_TOKEN=
