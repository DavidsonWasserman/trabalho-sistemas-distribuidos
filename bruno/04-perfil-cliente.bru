meta {
  name: Perfil de cliente
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/user/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{clientToken}}
}

tests {
  test("Identifica a conta com isAdmin igual a false", function () {
    expect(res.getStatus()).to.equal(200);
    const profile = res.getBody();
    expect(profile.email).to.equal(bru.getEnvVar("clientEmail"));
    expect(profile.isAdmin).to.equal(false);
    expect(profile).not.to.have.property("password");
  });
}
